            android:exported="false"
            android:parentActivityName=".ui.admin.AdminDashboardActivity"
            android:screenOrientation="portrait" />
        
        <activity
            android:name=".ui.coordinator.ModuleManagementActivity"
            android:exported="false"
            android:parentActivityName=".ui.coordinator.ProgramCoordinatorDashboardActivity"
            android:screenOrientation="portrait" />
        
        <activity
            android:name=".ui.coordinator.AssignLecturerActivity"
            android:exported="false"
            android:parentActivityName=".ui.coordinator.ProgramCoordinatorDashboardActivity"
            android:screenOrientation="portrait" />
        
        <activity
            android:name=".ui.coordinator.ApprovalsActivity"
            android:exported="false"
            android:parentActivityName=".ui.coordinator.ProgramCoordinatorDashboardActivity"
            android:screenOrientation="portrait" />
        
        <activity
            android:name=".ui.coordinator.ReportsActivity"
            android:exported="false"
            android:parentActivityName=".ui.coordinator.ProgramCoordinatorDashboardActivity"
            android:screenOrientation="portrait" />
        
        <activity
            android:name=".ui.coordinator.MonitorActivityActivity"
            android:exported="false"
            android:parentActivityName=".ui.coordinator.ProgramCoordinatorDashboardActivity"
            android:screenOrientation="portrait" />
        
        <!-- Firebase Cloud Messaging -->
        <service
            android:name=".service.FirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>