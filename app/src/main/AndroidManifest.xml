            android:name=".ui.lecturer.LecturerAttendanceActivity"
            android:exported="false"
            android:parentActivityName=".ui.lecturer.LecturerDashboardActivity"
            android:screenOrientation="portrait" />
        
        <activity
            android:name=".ui.lecturer.StudentProgressActivity"
            android:exported="false"
            android:parentActivityName=".ui.lecturer.LecturerDashboardActivity"
            android:screenOrientation="portrait" />
        
        <activity
            android:name=".ui.admin.UserManagementActivity"
            android:exported="false"
            android:parentActivityName=".ui.admin.AdminDashboardActivity"
            android:screenOrientation="portrait" />
        
        <activity
            android:name=".ui.admin.AssignRolesActivity"
            android:exported="false"
            android:parentActivityName=".ui.admin.AdminDashboardActivity"
            android:screenOrientation="portrait" />
        
        <activity
            android:name=".ui.admin.AcademicSettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.admin.AdminDashboardActivity"
            android:screenOrientation="portrait" />
        
        <activity
