<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">
    
    <!-- Rounded square with green gradient background -->
    <path
        android:pathData="M20,20 L100,20 A20,20 0 0,1 120,40 L120,100 A20,20 0 0,1 100,120 L20,120 A20,20 0 0,1 0,100 L0,40 A20,20 0 0,1 20,20 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startX="0"
                android:startY="0"
                android:endX="120"
                android:endY="120">
                <item
                    android:color="#66BB6A"
                    android:offset="0.0" />
                <item
                    android:color="#4CAF50"
                    android:offset="0.5" />
                <item
                    android:color="#388E3C"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    
    <!-- Letter "U" in white, centered -->
    <path
        android:pathData="M35,35 L35,75 Q35,85 45,85 L75,85 Q85,85 85,75 L85,35 L70,35 L70,75 Q70,80 65,80 L55,80 Q50,80 50,75 L50,35 Z"
